# Database — defaults to the docker-compose Postgres service.
# For a quick local run without Docker, set: DATABASE_URL=sqlite:///./projecto2.db
DATABASE_URL=postgresql+psycopg://o2_admin:o2_secret@localhost:5544/projecto2

# Auth
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS — the Next.js frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Workspace — only emails on this domain may sign up or be invited
WORKSPACE_EMAIL_DOMAIN=optiminastic.com

# Uploads
UPLOAD_DIR=./uploads

# Email — team invitations. Leave SMTP_HOST blank to disable sending; the Circle
# page then shows a copy-able invite link instead. For Gmail, use an App Password
# (not your normal password) and SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@optiminastic.com
SMTP_FROM_NAME=Project O2
SMTP_REPLY_TO=
SMTP_USE_TLS=true
INVITE_EXPIRE_HOURS=168

# Your company's details, printed on every proforma, tax invoice and agent MOU.
# Optiminastic's registered details are built in (app/config.py), so these stay
# commented out. Uncomment one only to override it: an empty value blanks the
# field, and a tax invoice cannot be issued without COMPANY_LEGAL_NAME and COMPANY_GSTIN.
# COMPANY_LEGAL_NAME=
# COMPANY_ADDRESS=
# COMPANY_GSTIN=
# COMPANY_STATE=
# COMPANY_PAN=
# COMPANY_EMAIL=
# COMPANY_BANK_NAME=
# COMPANY_BANK_ACCOUNT=
# COMPANY_BANK_IFSC=
# COMPANY_BANK_BRANCH=

# Add the standard service list (10 services with SAC codes) to the catalogue once, at startup.
# SEED_SERVICE_CATALOGUE=true
# Client links (/i/<token>): proforma approval links and tax invoice view links.
INVOICE_APPROVAL_LINK_DAYS=30
INVOICE_VIEW_LINK_DAYS=365

# GSTIN lookup (apiserver.in). Leave blank to only validate the number offline.
# Test keys start with as_test_, live keys with as_live_.
GST_API_KEY=
# GST_API_URL=https://api.apiserver.in/v1/gst/verify
